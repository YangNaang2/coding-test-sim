#.##.#.#.##..","#.##.....#..#..#....####....#..##.###.....####.....#...#.......##.###....#..#...###.#..#.##.#.....#.","###...#...###.#...#.#.#..#.#..#..#.#...#.#..#.###.#.##......###.###..#.##..####.##..#...##...##.#..#","#.###...#.####..##...#...#.#.#....##..##.###..##.#.#...##.###.##....#.#...##.##...###.#.##...######.",".....#...##.##..##...##.##.##.....#.#.###.....#..#....#...######.##..###..#..#.#..#........##.#.##..","#..##.########.#..#...#...##.#.....##...........##.#.###.##..###.#..###..##...#..#..#.####...#..##..","#.#.....##...#...#.....###.....#...##########..##...#...##....#.##.#..#.#....#####..##...######.....","##.#.##..#...##.#.....#...###.#.###.........##.###...#....#.#..#.#.#....#..#######.##.#..###.#.###.#",".##.#..#.#.....#.....##.##....##...........#..##...##....####..#####.##...#...###.#...#.###.#.......","...###..#.#.##..#.###....#.#.#.#.##.##.....##.#..##.#..#...###..#.#..#...#.......#....##.##..#..####","#..#.##...###.##...####.##.#...##.....#...#..#.....#....###.##.#.###...#...#.##..#.##.#.#...##.#.#..","#....#.##.#.......#.####.#..##.###.#.#.####.....#.#.##.##.##.#.###....###.####.##.##.#......#..#....","###..#....###.##.#.##.##.#..###..S###...#.###.#.##....#.####.#.#.#..#...........##..#..#.#...#..#...","##.#.###....##.####.#......#.##.#.#....##..#...#.#..#......#...##...#.....#.#....#.###.#..#....#.##.",".#.#...#.#.##....#..#...##.#...#...#..###.##.#.#.#..#..#....####....#.##.....##.##....#.##########.#","...#.##.##.##.#....##.....#.#.#...##...#.###.#..###.###.#.#...E....#.##...##..##..##..##.....#......","..#...#...##..#.##...##.#.#.#...#.#..#..#.####.##..#....##.###.......#......##...#..#..#.#.#...##.#.",".#.#..##.....#..####...##.....#.##.....#.#..#.....#...#.###.##..#######..##...##.###......###.#.##.#"]],"output":-1}],"solution":"from collections import deque\n\ndef bfs(maps, sr, sc):\n    n, m = len(maps), len(maps[0])\n    dist = [[-1] * m for _ in range(n)]\n    dist[sr][sc] = 0\n    q = deque([(sr, sc)])\n    while q:\n        r, c = q.popleft()\n        for nr, nc in ((r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)):\n            if 0 <= nr < n and 0 <= nc < m and maps[nr][nc] != '#' and dist[nr][nc] == -1:\n                dist[nr][nc] = dist[r][c] + 1\n                q.append((nr, nc))\n    return dist\n\ndef solution(maps):\n    desks = []\n    for r, row in enumerate(maps):\n        for c, ch in enumerate(row):\n            if ch == 'S':\n                start = (r, c)\n            elif ch == 'E':\n                end = (r, c)\n            elif ch == 'A':\n                desks.append((r, c))\n    ds = bfs(maps, *start)\n    de = bfs(maps, *end)\n    best = -1\n    for r, c in desks:\n        if ds[r][c] >= 0 and de[r][c] >= 0:\n            total = ds[r][c] + de[r][c]\n            if best == -1 or total < best:\n                best = total\n    return best","timeLimit":10}